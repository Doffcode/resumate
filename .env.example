# Copy to .env.local and fill in from the Supabase dashboard:
#   Project Settings -> API Keys
# .env.local is gitignored. Never paste these into chat or a commit.
#
# NOTE: this project has LEGACY API keys disabled. The old JWT-style anon key
# (starts "eyJ") will fail with "Legacy API keys are disabled". Use the new
# publishable key, which starts "sb_publishable_".
#
# Never put an "sb_secret_" key here — anything VITE_ prefixed is shipped to
# the browser. Secrets belong in Supabase Edge Function secrets only.

VITE_SUPABASE_URL=https://iznmieztlrytxeujfyci.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Vercel-only, never in this file, never VITE_ prefixed ---
# SUPABASE_SERVICE_ROLE_KEY: set via `vercel env add`, not here. Same legacy
# vs new key gotcha as above but easier to miss: the SAME "Legacy API keys
# are disabled" error applies to the service-role key too. Supabase's
# dashboard still labels the old eyJ... JWT "service_role" in one place and
# the new format "secret key" (starts "sb_secret_") in another — use the
# sb_secret_ one, confirmed the hard way via `vercel logs` after the eyJ
# version silently failed every write with this exact message.
# ADMIN_EMAIL: not a secret, just the address that unlocks /admin.
